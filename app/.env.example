# Copie para .env (não versionado) e preencha. Nada aqui é uma credencial real.
# O mesmo arquivo serve ao Docker Compose, ao Prisma, aos scripts e ao Next.js.

# Segredo do servidor: mínimo de 32 caracteres. Usado no HMAC da origem das tentativas de login. Gere com: openssl rand -hex 32
SESSION_SECRET=

# Banco de dados local (ADR-006). Gere senhas diferentes com: openssl rand -hex 16
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# mysql://acai:<MYSQL_PASSWORD>@127.0.0.1:3306/acai_conecta?allowPublicKeyRetrieval=true
# allowPublicKeyRetrieval: sem ele, o login falha depois que o MySQL reinicia. Só para o banco local; em produção use TLS.
DATABASE_URL=
