# Copie para .env.local (não versionado) e preencha. Nada aqui é uma credencial real.
# Segredo que assina a sessão da equipe: mínimo de 32 caracteres. Gere com: openssl rand -hex 32
SESSION_SECRET=
# Contas da equipe em JSON, com hash scrypt. Gere cada entrada com: pnpm acesso:gerar <email> admin
# ou: pnpm acesso:gerar <email> operador <storeId> "<Nome>". Exemplo de formato:
# STAFF_ACCOUNTS='[{"email":"admin@exemplo.com","role":"admin","name":"Administrador","hash":"scrypt:..."}]'
STAFF_ACCOUNTS=
