generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model bairros {
  id                 BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  nome               String               @unique(map: "uq_bairros_nome") @db.VarChar(100)
  nome_alternativo   String?              @db.VarChar(100)
  ativo              Boolean              @default(true)
  criado_em          DateTime             @default(now()) @db.Timestamp(0)
  atualizado_em      DateTime             @default(now()) @db.Timestamp(0)
  batedeiras         batedeiras[]
  batedeiras_bairros batedeiras_bairros[]
  enderecos_clientes enderecos_clientes[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model batedeiras {
  id                     BigInt                            @id @default(autoincrement()) @db.UnsignedBigInt
  responsavel_id         BigInt                            @unique(map: "uq_batedeiras_responsavel") @db.UnsignedBigInt
  nome                   String                            @db.VarChar(150)
  descricao              String?                           @db.VarChar(500)
  telefone_operacional   String?                           @db.VarChar(20)
  imagem_url             String?                           @db.VarChar(2048)
  endereco               String                            @db.VarChar(255)
  bairro_id              BigInt                            @db.UnsignedBigInt
  ponto_referencia       String?                           @db.VarChar(255)
  documento_tipo         batedeiras_documento_tipo
  documento              String                            @db.VarChar(14)
  status                 batedeiras_status                 @default(EM_ANALISE)
  aberta                 Boolean                           @default(false)
  entrega_disponivel     Boolean                           @default(false)
  estimativa_minutos_min Int                               @db.UnsignedSmallInt
  estimativa_minutos_max Int                               @db.UnsignedSmallInt
  conta_pagamento_id     String?                           @unique(map: "uq_batedeiras_conta_pagamento") @db.VarChar(100)
  conta_pagamento_status batedeiras_conta_pagamento_status @default(NAO_CADASTRADA)
  criado_em              DateTime                          @default(now()) @db.Timestamp(0)
  atualizado_em          DateTime                          @default(now()) @db.Timestamp(0)
  bairros                bairros                           @relation(fields: [bairro_id], references: [id], onUpdate: Restrict, map: "fk_batedeiras_bairro")
  usuarios               usuarios                          @relation(fields: [responsavel_id], references: [id], onUpdate: Restrict, map: "fk_batedeiras_responsavel")
  batedeiras_bairros     batedeiras_bairros[]
  horarios_funcionamento horarios_funcionamento[]
  pedidos                pedidos[]
  produtos               produtos[]

  @@index([bairro_id], map: "idx_batedeiras_bairro")
  @@index([status, aberta, entrega_disponivel], map: "idx_batedeiras_status_disponibilidade")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model batedeiras_bairros {
  id                     BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  batedeira_id           BigInt     @db.UnsignedBigInt
  bairro_id              BigInt     @db.UnsignedBigInt
  taxa_entrega_centavos  Int        @default(0) @db.UnsignedInt
  estimativa_minutos_min Int        @db.UnsignedSmallInt
  estimativa_minutos_max Int        @db.UnsignedSmallInt
