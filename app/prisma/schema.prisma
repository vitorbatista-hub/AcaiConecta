  usuarios_contestacoes_decidida_porTousuarios usuarios?           @relation("contestacoes_decidida_porTousuarios", fields: [decidida_por], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_contestacoes_decisor")
  pedidos                                      pedidos             @relation(fields: [pedido_id], references: [id], onUpdate: Restrict, map: "fk_contestacoes_pedido")
  estornos                                     estornos[]

  @@index([cliente_id], map: "fk_contestacoes_cliente")
  @@index([decidida_por], map: "fk_contestacoes_decisor")
  @@index([status, responder_ate], map: "idx_contestacoes_fila")
  @@index([pedido_id], map: "idx_contestacoes_pedido")
