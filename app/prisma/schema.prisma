  responder_ate                                DateTime            @db.Timestamp(0)
  primeira_resposta_em                         DateTime?           @db.Timestamp(0)
  decidida_por                                 BigInt?             @db.UnsignedBigInt
  decidida_em                                  DateTime?           @db.Timestamp(0)
  decisao                                      String?             @db.VarChar(500)
  criado_em                                    DateTime            @default(now()) @db.Timestamp(0)
  pedido_aberto_id                             BigInt?             @unique(map: "uq_contestacoes_aberta_por_pedido") @db.UnsignedBigInt
